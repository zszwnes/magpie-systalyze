{
  "name": "magpie-systalyze",
  "version": "0.1.3",
  "description": "magpie provider plugin for Systalyze (inference.systalyze.com): its 10 models with capabilities and prices, official balance and billing from the console session cookie, or a usage estimate from magpie's own ledger",
  "type": "module",
  "main": "./index.mjs",
  "exports": "./index.mjs",
  "files": [
    "index.mjs",
    "models.mjs",
    "usage-store.mjs",
    "console-usage.mjs",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/smoke.mjs",
    "check": "node --check index.mjs && node --check models.mjs && node --check usage-store.mjs && node --check console-usage.mjs && node test/smoke.mjs"
  },
  "keywords": [
    "magpie",
    "magpie-plugin",
    "opencode",
    "opencode-plugin",
    "systalyze",
    "inference",
    "provider"
  ],
  "author": "zszwnes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zszwnes/magpie-systalyze.git"
  },
  "homepage": "https://github.com/zszwnes/magpie-systalyze#readme",
  "bugs": {
    "url": "https://github.com/zszwnes/magpie-systalyze/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "magpie": {
    "icon": "data:image/svg+xml;base64,",
    "options": {
      "localUsage": true,
      "perModel": true,
      "budget": 0,
      "budgetDaily": 0,
      "consoleSession": ""
    }
  }
}
